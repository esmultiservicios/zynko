# Secretos / entorno de producción
.env
.env.*
!.env.example

# Datos/runtime que ZYNKO modifica en producción
storage/installed.lock
storage/logs/*
!storage/logs/.gitkeep
storage/cache/*
!storage/cache/.gitkeep
storage/env-backups/*
!storage/env-backups/.gitkeep
public/uploads/

# Archivos creados por cPanel / hosting
.well-known/
.user.ini
php.ini
error_log
*.log
.cpanel/
cpanel-logs/
*.pid
*.sock

# Sistema / editores
.DS_Store
Thumbs.db
.vscode/
.idea/
