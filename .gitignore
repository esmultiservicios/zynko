# ZYNKO · archivos locales / runtime que nunca deben entrar al repositorio
.env
.env.*
!.env.example

# Runtime generado por WebSocket y aplicación
storage/websocket.pid
storage/websocket.restart.marker
storage/websocket.state.json
storage/logs/*
!storage/logs/.gitkeep
storage/cache/*
!storage/cache/.gitkeep
storage/env-backups/*
!storage/env-backups/.gitkeep
storage/sessions/*
!storage/sessions/.gitkeep

# Archivos generados por hosting / PHP
.user.ini
php.ini
error_log
*.log

# Uploads persistentes del servidor
public/uploads/*

# Sistema / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
