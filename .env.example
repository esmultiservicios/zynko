APP_ENV=local
APP_URL=http://localhost
APP_KEY=CHANGE_ME_64_HEX
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=metahub
DB_USERNAME=root
DB_PASSWORD=
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=vXX.X
# WebSocket interno: donde escucha websocket/server.php en el servidor.
WS_HOST="127.0.0.1"
WS_PORT=8080

# WebSocket público: dirección que recibe el navegador.
# En producción HTTPS se recomienda publicar el socket mediante un proxy TLS en 443.
WS_PUBLIC_HOST=localhost
WS_PUBLIC_PORT=8080
WS_PUBLIC_SCHEME=ws
# Si existe proxy/reverse proxy, esta URL tiene prioridad sobre HOST/PORT/SCHEME.
# Ejemplo: wss://zynkocloud.app/ws
WS_PUBLIC_URL=

# SEO / sitio público
SEO_SITE_NAME=ZYNKO
SEO_DESCRIPTION=Plataforma SaaS omnicanal para centralizar conversaciones, Web Chat, automatización y atención humana.
SEO_LOCALE=es_HN
SEO_TWITTER=
